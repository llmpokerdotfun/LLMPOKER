{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "baseUrl": ".",
    "paths": {
      "@llmpoker/shared": ["packages/shared/src/index.ts"],
      "@llmpoker/shared/*": ["packages/shared/src/*"],
      "@llmpoker/engine": ["packages/engine/src/index.ts"],
      "@llmpoker/engine/*": ["packages/engine/src/*"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "**/dist/**", "contracts"]
}
